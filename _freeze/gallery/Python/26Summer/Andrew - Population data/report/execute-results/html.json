_diff', kind = 'line', hue = 'region')\n\nsns.relplot(df_s, x = 'year', y= 'le_birth', kind = 'line', hue = 'region')\n\nsns.relplot(df_s, x = 'year', y= 'young_birth_ratio', kind = 'line', hue = 'region')\n```\n\n::: {.cell-output .cell-output-display}\n![](report_files/figure-html/cell-12-output-1.png){width=663 height=470}\n:::\n\n::: {.cell-output .cell-output-display}\n![](report_files/figure-html/cell-12-output-2.png){width=665 height=470}\n:::\n\n::: {.cell-output .cell-output-display}\n![](report_files/figure-html/cell-12-output-3.png){width=665 height=470}\n:::\n\n::: {.cell-output .cell-output-display}\n![](report_files/figure-html/cell-12-output-4.png){width=659 height=470}\n:::\n\n::: {.cell-output .cell-output-display}\n![](report_files/figure-html/cell-12-output-5.png){width=659 height=470}\n:::\n\n::: {.cell-output .cell-output-display}\n![](report_files/figure-html/cell-12-output-6.png){width=665 height=470}\n:::\n\n::: {.cell-output .cell-output-display}\n![](report_files/figure-html/cell-12-output-7.png){width=659 height=470}\n:::\n:::\n\n\n",
